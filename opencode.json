{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "form": {
      "type": "remote",
      "url": "http://127.0.0.1:8000/mcp",
      "enabled": true,
      "oauth": false
    },
    "openindustries": {
      "type": "local",
      "command": [
        "node",
        "server/openindustries-mcp.mjs"
      ],
      "cwd": ".",
      "enabled": true,
      "environment": {
        "OI_SCENE_TOOLS_ENABLED": "true",
        "OI_SCENE_BACKEND": "local"
      }
    },
    "aws": {
      "type": "remote",
      "url": "https://aws-mcp.us-east-1.api.aws/mcp",
      "enabled": false
    },
    "farm": {
      "type": "local",
      "command": [
        "ssh",
        "-T",
        "-o",
        "BatchMode=yes",
        "oi-inspection",
        "sudo",
        "-n",
        "/usr/local/bin/oi-farm-mcp"
      ],
      "enabled": false
    }
  }
}
