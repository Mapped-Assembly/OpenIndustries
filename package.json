{
  "name": "open-industries",
  "version": "0.1.1",
  "description": "Spatial workbench for hardware and manufacturing-system planning",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mapped-Assembly/Open-Industries.git"
  },
  "bugs": {
    "url": "https://github.com/Mapped-Assembly/Open-Industries/issues"
  },
  "homepage": "https://github.com/Mapped-Assembly/Open-Industries#readme",
  "engines": {
    "node": ">=22.16.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "bin": {
    "openindustries": "cli/openindustries.mjs",
    "astra": "cli/astra.mjs"
  },
  "scripts": {
    "ci:game:browser": "concurrently --max-processes 2 --success all --timings --no-color --names full,results,integration \"npm --prefix .integration/tower-defense run test:browser:full\" \"npm --prefix .integration/tower-defense run test:browser:results\" \"npm --prefix .integration/tower-defense run test:integration\"",
    "ci:game:ubuntu": "concurrently --max-processes 2 --success all --timings --no-color --names victory,manufacturing,combat,units,mcp-game,simulation,materials,mcp \"npm run test:victory\" \"npm run test:manufacturing\" \"npm run test:combat\" \"npm run test:units\" \"npm run test:mcp-game\" \"npm run test:simulation\" \"npm run test:materials\" \"npm run test:mcp\"",
    "ci:game:windows": "concurrently --max-processes 2 --success all --timings --no-color --names manufacturing,mcp-game,simulation,materials,mcp \"npm run test:manufacturing\" \"npm run test:mcp-game\" \"npm run test:simulation\" \"npm run test:materials\" \"npm run test:mcp\"",
    "test:mcp-game": "node --import tsx scripts/game-robots-test.ts && node --import tsx scripts/game-spatial-sensing-test.ts && node --import tsx scripts/game-world-test.ts && node --import tsx scripts/mcp-game-test.ts && node --import tsx scripts/game-all-waste-test.ts",
    "test:project-files": "node --import tsx scripts/project-files-test.ts",
    "test:project-files-browser": "node --import tsx scripts/project-files-browser-test.ts",
    "test:room-transitions": "node --import tsx scripts/room-transitions-test.ts",
    "test:animation": "node --import tsx scripts/animation-test.ts",
    "test:animation-browser": "node --import tsx scripts/animation-browser-test.ts",
    "test:camera-depth": "node --import tsx scripts/camera-depth-test.ts",
    "postinstall": "node scripts/prepare-vendor.mjs",
    "dev": "concurrently -k -n api,web \"node --env-file-if-exists=.env server/index.mjs\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.mcp.json && tsc -p tsconfig.simulation.json && vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node scripts/smoke.mjs",
    "test:e2e": "node scripts/smoke.mjs",
    "test:form-import": "node --import tsx scripts/form-import-test.ts",
    "test:cad": "tsx scripts/cad-import-test.ts",
    "test:scene": "tsx scripts/scene-manifest-test.ts",
    "test:draft-recovery": "node scripts/draft-recovery-smoke.mjs",
    "test:room-drafts": "node scripts/room-draft-smoke.mjs",
    "test:mcp": "node --import tsx scripts/mcp-rooms-test.ts && node --test scripts/mcp-branding-test.mjs",
    "test:scene-crud": "tsx scripts/scene-crud-smoke.ts",
    "test:gif": "node scripts/gif-smoke.mjs",
    "test:auth": "node scripts/auth-smoke.mjs",
    "test:storage": "tsx scripts/cloud-storage-smoke.ts",
    "test:workspace": "tsx scripts/workspace-test.ts",
    "test:portable-scenes": "node --import tsx scripts/portable-scene-test.ts",
    "test:portable-scenes-browser": "node --import tsx scripts/portable-scene-test.ts --browser",
    "test:workspace-live": "tsx scripts/workspace-smoke.ts",
    "test:storage-disabled": "node scripts/cloud-storage-disabled-smoke.mjs",
    "test:fullscreen": "node scripts/fullscreen-smoke.mjs && node scripts/fullscreen-import-smoke.mjs",
    "test:scene-links": "node --import tsx scripts/scene-links-test.ts",
    "test:scene-links-browser": "node --import tsx scripts/scene-links-browser-test.ts",
    "test:local-scenes": "node --import tsx scripts/local-scenes-test.ts",
    "test:opencad-robot": "node --import tsx scripts/opencad-robot-handoff-test.ts",
    "test:mcp-scenes": "node --import tsx scripts/mcp-scenes-test.ts",
    "test:mcp-scenes-browser": "node --import tsx scripts/mcp-scenes-test.ts --browser",
    "test:scene-history": "node --import tsx scripts/scene-history-test.ts",
    "test:scene-history-browser": "node --import tsx scripts/scene-history-test.ts --browser",
    "test:mcp-agent-workflows": "node --import tsx scripts/mcp-agent-workflows-test.ts",
    "test:mcp-agent-workflows-browser": "node --import tsx scripts/mcp-agent-workflows-test.ts --browser",
    "demo:mcp-scene": "node scripts/replay-scene-workflow.mjs",
    "test:form-workflows": "node --import tsx scripts/form-workflows-test.ts",
    "test:form-workflows-browser": "node --import tsx scripts/form-workflows-browser-test.ts",
    "game:server": "node --env-file-if-exists=.env server/game-service.mjs",
    "simulation:server": "node --env-file-if-exists=.env --import tsx server/simulation-service.ts",
    "test:simulation": "npm run build:local-runtime && node --import tsx --test tests/simulation/*.test.ts",
    "build:materials": "tsc -p packages/material-science/tsconfig.json",
    "test:materials": "node --import tsx --test packages/material-science/tests/*.test.ts && node --import tsx scripts/game-materials-test.ts",
    "field-lab:server": "node --env-file-if-exists=.env --import tsx server/field-lab-service.ts",
    "test:field-lab": "node --import tsx scripts/field-lab-durable-test.ts",
    "test:manufacturing": "node --import tsx scripts/game-manufacturing-test.ts",
    "test:units": "node --import tsx scripts/game-manufacturing-test.ts --units",
    "test:combat": "node --import tsx scripts/game-manufacturing-test.ts --combat",
    "test:victory": "node --import tsx scripts/game-manufacturing-test.ts --victory",
    "test:runtime-deployment": "tsc -p tsconfig.simulation.json && node --import tsx --test tests/simulation/deployment.test.ts",
    "test:field-lab-scene": "node --import tsx scripts/field-lab-playback-test.ts",
    "field-lab:viewer": "node --import tsx scripts/field-lab-viewer.ts",
    "test:field-lab-scene-browser": "node --import tsx scripts/field-lab-browser-test.ts",
    "build:local-runtime": "tsc -p tsconfig.simulation.json && vite build --config vite.local-runtime.config.ts",
    "test:local-runtime": "npm run build:local-runtime && node --import tsx --test tests/simulation/local-runtime.test.ts",
    "embodied:serve": "python3 scripts/embodied_runtime.py",
    "test:embodied-browser": "node --import tsx scripts/embodied-browser-test.ts",
    "test:mcp-branding": "node --test scripts/mcp-branding-test.mjs",
    "test:cabinet-browser": "node --import tsx scripts/cabinet-browser-test.ts",
    "test:cabinet-scene": "node --import tsx scripts/cabinet-scene-test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "ajv": "^8.17.1",
    "express": "^5.1.0",
    "gifenc": "^1.0.3",
    "lucide-react": "^0.468.0",
    "occt-import-js": "0.0.23",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0",
    "tsx": "^4.20.0",
    "@openindustries/material-science": "file:packages/material-science"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "omggif": "^1.0.10",
    "supabase": "2.117.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.1"
  }
}
