<mujoco model="native-render-physics-proof">
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>
  <worldbody>
    <geom name="ground" type="plane" size="4 3 0.1" friction="0.8 0.005 0.0001"/>
    <body name="falling-block" pos="-1 0 2">
      <freejoint/>
      <geom type="box" size="0.5 0.3 0.4" mass="2" friction="0.8 0.005 0.0001"/>
    </body>
    <body name="pendulum" pos="1.5 0 2.5">
      <joint name="hinge" type="hinge" axis="0 1 0" damping="0.15"/>
      <geom type="box" pos="0 0 -0.8" size="0.1 0.1 0.8" mass="1"/>
    </body>
  </worldbody>
  <keyframe><key name="release" qpos="-1 0 2 1 0 0 0 0.65"/></keyframe>
</mujoco>
